# ============================================================
# Exam Platform — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Database -----------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql://examplatform:examplatform_secret@localhost:5432/examplatform

# ---- Redis --------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- Security -----------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Groq LLM (for question extraction) --------------------
# Get free API key at: https://console.groq.com
# Leave blank to use mock extractor
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ---- Document Processing ------------------------------------
# Set to true to use mock extractor (no Groq key needed)
USE_MOCK_EXTRACTOR=true
MAX_UPLOAD_SIZE_MB=50

# ---- Storage ------------------------------------------------
# Options: local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads

# S3-compatible storage (leave blank if using local)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_REGION=ap-south-1

# ---- Payments -----------------------------------------------
# Set to true to use mock payment adapter (no Juspay account needed)
USE_MOCK_PAYMENT=true

# Juspay credentials (sandbox)
JUSPAY_MERCHANT_ID=
JUSPAY_API_KEY=
JUSPAY_BASE_URL=https://sandbox.juspay.in
JUSPAY_WEBHOOK_SECRET=

# ---- CORS ---------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]

# ---- Frontend (Next.js) ------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_PAYMENT=true
